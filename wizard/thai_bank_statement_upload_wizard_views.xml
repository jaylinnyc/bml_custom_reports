<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Wizard Form View -->
        <record id="view_thai_bank_statement_upload_wizard_form" model="ir.ui.view">
            <field name="name">bml.thai.bank.statement.wizard.form</field>
            <field name="model">bml.thai.bank.statement.wizard</field>
            <field name="arch" type="xml">
                <form string="Upload Thai Bank Statement">
                    <sheet>
                        <group>
                            <group>
                                <field name="journal_id" 
                                       options="{'no_create': True, 'no_open': True}"
                                       required="1"/>
                                <field name="statement_name" 
                                       placeholder="e.g., Bank Statement January 2026"/>
                            </group>
                            <group>
                                <field name="currency_id" invisible="1"/>
                                <field name="company_id" invisible="1"/>
                                <field name="balance_start" 
                                       widget="monetary"
                                       options="{'currency_field': 'currency_id'}"/>
                                <field name="balance_end" 
                                       widget="monetary"
                                       options="{'currency_field': 'currency_id'}"/>
                            </group>
                        </group>
                        
                        <group>
                            <field name="filename" invisible="1"/>
                            <field name="statement_file" 
                                   widget="binary" 
                                   filename="filename"
                                   required="1"/>
                        </group>
                        
                        <div class="alert alert-info" role="alert">
                            <strong>Supported Formats:</strong>
                            <ul>
                                <li>Excel files (.xlsx, .xls)</li>
                                <li>CSV files (.csv)</li>
                            </ul>
                            <strong>Requirements:</strong>
                            <ul>
                                <li>File must contain columns for: Date, Description, and Debit/Credit amounts</li>
                                <li>Thai language columns are supported (วันที่, รายละเอียด, จ่าย, รับ, etc.)</li>
                                <li>Transactions will be automatically detected and imported</li>
                            </ul>
                        </div>
                    </sheet>
                    <footer>
                        <button string="Upload and Import"
                                name="action_upload_statement"
                                type="object"
                                class="btn-primary"
                                data-hotkey="q"/>
                        <button string="Delete Duplicates"
                                name="action_delete_duplicates"
                                type="object"
                                class="btn-warning"
                                invisible="not statement_file"
                                confirm="This will delete any bank statement lines from a previous import of this file. If any have been auto-reconciled to invoices or payments, those reconciliations will be undone first. Continue?"/>
                        <button string="Cancel"
                                class="btn-secondary"
                                special="cancel"
                                data-hotkey="z"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Wizard Action -->
        <record id="action_thai_bank_statement_upload_wizard" model="ir.actions.act_window">
            <field name="name">Upload Thai Bank Statement</field>
            <field name="res_model">bml.thai.bank.statement.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="view_id" ref="view_thai_bank_statement_upload_wizard_form"/>
        </record>

    </data>
</odoo>
