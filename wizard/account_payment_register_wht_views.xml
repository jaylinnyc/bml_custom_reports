<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
    Thailand WHT Payment Register Wizard Extension
    
    Features:
    1. Shows WHT breakdown for bills being paid (display only)
       WHT entries are created by Odoo's native cash basis mechanism.
    2. Manual writeoff toggle - allows applying adjustments even without
       automatic payment difference (for advance/split payments, bank charges)
    -->

    <record id="view_account_payment_register_form_wht" model="ir.ui.view">
        <field name="name">account.payment.register.form.wht</field>
        <field name="model">account.payment.register</field>
        <field name="inherit_id" ref="account.view_account_payment_register_form"/>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            
            <!-- Add invisible technical field -->
            <xpath expr="//field[@name='hide_writeoff_section']" position="after">
                <field name="show_writeoff_section" invisible="1"/>
            </xpath>
            
            <!-- Add manual adjustment toggle after group_payment field -->
            <xpath expr="//field[@name='group_payment']" position="after">
                <field name="force_writeoff" 
                       string="Apply Adjustment"
                       widget="boolean_toggle"
                       invisible="not can_edit_wizard"
                       help="Enable to manually add payment adjustments (bank charges, partial payments, advance payments)"/>
            </xpath>
            
            <!-- Override the payment_difference label visibility to use our computed field -->
            <xpath expr="//label[@for='payment_difference']" position="attributes">
                <attribute name="invisible">not show_writeoff_section</attribute>
            </xpath>
            
            <!-- Override the payment_difference div visibility to use our computed field -->
            <xpath expr="//label[@for='payment_difference']/following-sibling::div[1]" position="attributes">
                <attribute name="invisible">not show_writeoff_section</attribute>
            </xpath>
            
            <!-- WHT Information Section (display only for vendor bills) -->
            <xpath expr="//group[@name='group2']" position="after">
                <group string="Withholding Tax Information" 
                       name="wht_section"
                       invisible="not has_wht"
                       col="4">
                    
                    <field name="has_wht" invisible="1"/>
                    
                    <group col="2">
                        <field name="gross_amount" string="Gross Amount" readonly="1"/>
                        <field name="total_wht_amount" string="WHT Deducted" readonly="1"/>
                    </group>
                    
                    <group col="4" colspan="4">
                        <field name="wht_line_ids" nolabel="1" colspan="4">
                            <list create="false" delete="false">
                                <field name="tax_name" string="WHT Tax" readonly="1"/>
                                <field name="rate" string="Rate (%)" readonly="1"/>
                                <field name="base_amount" sum="Total" readonly="1"/>
                                <field name="wht_amount" sum="Total" readonly="1"/>
                                <field name="currency_id" column_invisible="True"/>
                            </list>
                        </field>
                    </group>
                </group>
            </xpath>
            
        </field>
    </record>

</odoo>
