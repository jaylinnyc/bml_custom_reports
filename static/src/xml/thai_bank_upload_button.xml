<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- Extend the default ListView.Buttons to add Upload Thai Statement button -->
    <t t-name="web.ListView.Buttons" t-inherit="web.ListView.Buttons" t-inherit-mode="extension">
        <xpath expr="." position="inside">
            <t t-if="env.model.root.resModel === 'account.bank.statement'">
                <button class="btn btn-secondary ms-1" 
                        t-on-click="() => this.uploadThaiStatement()"
                        title="Upload Thai Bank Statement">
                    <i class="fa fa-upload me-1"/>Upload Thai Statement
                </button>
            </t>
        </xpath>
    </t>
</templates>
