<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="account_accountant.BankRecoKanbanController" 
       t-inherit="account_accountant.BankRecoKanbanController" 
       t-inherit-mode="extension">
        <xpath expr="//Layout" position="inside">
            <t t-set-slot="control-panel-always-buttons">
                <button
                    t-on-click="() => this.autoReconcileAll()"
                    class="btn btn-primary"
                    data-tooltip="Auto Reconcile All Unreconciled Transactions">
                    <i class="fa fa-magic me-1"/>
                    Auto Reconcile
                </button>
            </t>
        </xpath>
    </t>
</templates>
