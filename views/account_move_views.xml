<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Make accounting date readonly for vendor bills -->
    <record id="view_move_form_inherit_date_sync" model="ir.ui.view">
        <field name="name">account.move.form.inherit.date.sync</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Make date field readonly for vendor bills and show help text -->
            <xpath expr="//field[@name='date']" position="attributes">
                <attribute name="readonly">move_type == 'in_invoice'</attribute>
                <attribute name="help">For vendor bills, this is automatically set to match the Bill Date</attribute>
            </xpath>
        </field>
    </record>
</odoo>
