<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Hide Accounting Date, show Delivery Date only -->
    <record id="view_move_form_inherit_date_sync" model="ir.ui.view">
        <field name="name">account.move.form.inherit.date.sync</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Hide Accounting Date (date field) -->
            <xpath expr="//field[@name='date']" position="attributes">
                <attribute name="invisible">True</attribute>
            </xpath>
            
            <!-- Add Delivery Date field (below invoice_date) -->
            <xpath expr="//field[@name='invoice_date']" position="after">
                <field name="delivery_date" 
                       invisible="move_type not in ['out_invoice', 'out_refund', 'in_invoice', 'in_refund']"/>
            </xpath>
        </field>
    </record>
</odoo>
