<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_delivery_date_mismatch_report_list" model="ir.ui.view">
        <field name="name">delivery.date.mismatch.report.list</field>
        <field name="model">delivery.date.mismatch.report</field>
        <field name="arch" type="xml">
            <list string="Delivery Date Mismatch Report" create="false" edit="false" delete="false">
                <field name="name" string="Document Number"/>
                <field name="partner_id"/>
                <field name="move_type"/>
                <field name="invoice_date"/>
                <field name="delivery_date"/>
                <field name="date_difference" string="Days Diff"/>
                <field name="amount_total"/>
                <field name="currency_id" invisible="1"/>
                <field name="state"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_delivery_date_mismatch_report_search" model="ir.ui.view">
        <field name="name">delivery.date.mismatch.report.search</field>
        <field name="model">delivery.date.mismatch.report</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="move_type"/>
                <field name="invoice_date"/>
                <field name="delivery_date"/>
                
                <filter string="Customer Invoices" name="customer_invoices" domain="[('move_type', '=', 'out_invoice')]"/>
                <filter string="Vendor Bills" name="vendor_bills" domain="[('move_type', '=', 'in_invoice')]"/>
                <filter string="Credit Notes" name="credit_notes" domain="[('move_type', 'in', ['out_refund', 'in_refund'])]"/>
                
                <separator/>
                <filter string="Invoice Date" name="filter_invoice_date" date="invoice_date"/>
                <filter string="Delivery Date" name="filter_delivery_date" date="delivery_date"/>
                
                <group expand="0" string="Group By">
                    <filter string="Partner" name="group_by_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Type" name="group_by_type" context="{'group_by': 'move_type'}"/>
                    <filter string="Invoice Date" name="group_by_invoice_date" context="{'group_by': 'invoice_date:month'}"/>
                    <filter string="Delivery Date" name="group_by_delivery_date" context="{'group_by': 'delivery_date:month'}"/>
                    <filter string="Company" name="group_by_company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Pivot View -->
    <record id="view_delivery_date_mismatch_report_pivot" model="ir.ui.view">
        <field name="name">delivery.date.mismatch.report.pivot</field>
        <field name="model">delivery.date.mismatch.report</field>
        <field name="arch" type="xml">
            <pivot string="Delivery Date Mismatch Analysis">
                <field name="move_type" type="row"/>
                <field name="invoice_date" interval="month" type="col"/>
                <field name="amount_total" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Graph View -->
    <record id="view_delivery_date_mismatch_report_graph" model="ir.ui.view">
        <field name="name">delivery.date.mismatch.report.graph</field>
        <field name="model">delivery.date.mismatch.report</field>
        <field name="arch" type="xml">
            <graph string="Delivery Date Mismatch Analysis" type="bar">
                <field name="move_type"/>
                <field name="amount_total" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Action -->
    <record id="action_delivery_date_mismatch_report" model="ir.actions.act_window">
        <field name="name">Delivery Date Mismatch Report</field>
        <field name="res_model">delivery.date.mismatch.report</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No mismatches found
            </p>
            <p>
                This report shows all invoices and bills where the delivery date differs from the invoice/bill date.
            </p>
        </field>
    </record>

    <!-- Menu Item under Accounting > Reporting -->
    <menuitem id="menu_delivery_date_mismatch_report"
              name="Delivery Date Mismatch"
              parent="account.menu_finance_reports"
              action="action_delivery_date_mismatch_report"
              sequence="50"/>
</odoo>
