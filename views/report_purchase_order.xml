<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- BML - Signature left, Totals right (FIXED - no more Unicode/XML error) -->
        <template id="bml_po_signature_side_by_side"
                  inherit_id="purchase.report_purchaseorder_document"
                  name="BML - PO Signature left + Totals right"
                  priority="50">

            <!-- Remove payment terms after the notes -->
            <xpath expr="//p[@t-field=&quot;o.note&quot;]/following::strong[1]" position="replace"/>
            <!-- <xpath expr="//p[@t-field=&quot;o.note&quot;]/following::span[@t-field=&quot;o.payment_term_id&quot;][1]" position="replace"/> -->

            <!-- FINAL FIX: align-items-start = both blocks start from the top -->
            <xpath expr="//div[@id='total']" position="attributes">
                <attribute name="class">row justify-content-between align-items-start</attribute>
            </xpath>

            <!-- Insert signature block BEFORE totals -->
            <xpath expr="//div[@id='total']/div[@class='col-4']" position="before">
                <div class="col-auto text-center" style="page-break-inside: avoid;">
                    <div style="height: 60px; display: flex; align-items: end; justify-content: center;">
                        <t t-if="o.x_studio_approval_signature">
                            <img t-att-src="image_data_uri(o.x_studio_approval_signature)"
                                style="max-height: 100px; width: auto; object-fit: contain;"/>
                        </t>
                        <t t-else="">
                            <div style="height: 100px; width: 280px;"></div>
                        </t>
                    </div>
                    <div style="border-top: 2px solid #000; width: 280px; margin: 8px auto 4px auto;"></div>
                    <div style="font-weight: bold; font-size: 13px;">
                        ผู้อนุมัติ / Approved by
                    </div>
                    <t t-if="o.date_approve">
                        <div class="mt-2">
                            <strong style="font-size: 15px;">
                                <span t-field="o.date_approve" t-options="{&quot;widget&quot;: &quot;date&quot;}"/>
                            </strong>
                            <br/>
                            <span style="font-weight: bold; font-size: 13px;">
                                วันที่อนุมัติ / Approval Date
                            </span>
                        </div>
                    </t>
                </div>
            </xpath>

            <!-- Keep totals right-aligned and auto-width -->
            <xpath expr="//div[@id='total']/div[@class='col-4']" position="attributes">
                <attribute name="class">col-auto ms-auto</attribute>
            </xpath>

        </template>

        <!-- Fix the 42px top padding on address block (works on all reports) -->
        <template id="bml_address_padding_fix"
                  inherit_id="web.address_layout"
                  name="BML - Remove address top padding"
                  priority="100">
            <xpath expr="//div[@t-if=&quot;address&quot;]" position="attributes">
                <attribute name="style">padding-top: 0 !important; margin-top: 0 !important;</attribute>
                <attribute name="class">address row mb-0</attribute>
            </xpath>
        </template>

    </data>
</odoo>