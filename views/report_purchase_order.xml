<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- ======================================================= -->
        <!-- 1. PURCHASE ORDER (Confirmed) - Signature Left / Totals Right -->
        <!-- ======================================================= -->
        <template id="bml_po_signature_side_by_side"
                  inherit_id="purchase.report_purchaseorder_document"
                  name="BML - PO Signature left + Totals right"
                  priority="50">

            <!-- Optional: remove payment terms line -->
            <xpath expr="//p[@t-field='o.note']/following::strong[1]" position="replace"/>

            <!-- 1. PARENT: Clear floats -->
            <xpath expr="//div[@id='total']" position="attributes">
                <attribute name="class">mt-4 clearfix</attribute>
                <attribute name="style">min-height: 150px;</attribute>
            </xpath>

            <!-- 2. TOTALS (RIGHT): Force Float Right -->
            <xpath expr="//div[@id='total']/div[1]" position="attributes">
                <attribute name="class">float-end</attribute>
                <attribute name="style">float: right; width: 50%; min-width: 300px; margin: 0 !important; padding: 0;</attribute>
            </xpath>

            <!-- 3. SIGNATURE & DATE (LEFT): Split into 2 columns -->
            <xpath expr="//div[@id='total']/div[1]" position="before">
                <div class="float-start" style="float: left; width: 48%; padding-right: 10px; box-sizing: border-box;">
                    <div class="row m-0">
                        <!-- Signature Col -->
                        <div class="col-6 text-center px-1">
                            <div style="height: 80px; display: flex; align-items: flex-end; justify-content: center;">
                                <t t-if="o.x_studio_approval_signature">
                                    <img t-att-src="image_data_uri(o.x_studio_approval_signature)" 
                                         style="max-height: 75px; width: auto; object-fit: contain; margin-bottom: 2px;"/>
                                </t>
                            </div>
                            <div style="border-top: 1px solid black; width: 100%; margin: 5px auto;"/>
                            <span style="font-size: 11px;">ผู้อนุมัติ / Approved by</span>
                        </div>
                        <!-- Date Col -->
                        <div class="col-6 text-center px-1">
                            <div style="height: 80px; position: relative;">
                                <div style="position: absolute; bottom: 3px; left: 0; right: 0; width: 100%;">
                                    <t t-if="o.date_approve">
                                        <strong style="font-size: 14px;">
                                            <span t-field="o.date_approve" t-options="{&quot;widget&quot;: &quot;date&quot;}"/>
                                        </strong>
                                    </t>
                                    <t t-else="">
                                        <span style="color: #eee;">.</span> 
                                    </t>
                                </div>
                            </div>
                            <div style="border-top: 1px solid black; width: 100%; margin: 5px auto;"/>
                            <span style="font-size: 11px;">วันที่อนุมัติ / Approval Date</span>
                        </div>
                    </div>
                </div>
            </xpath>
        </template>


        <!-- ======================================================= -->
        <!-- 2. REQUEST FOR QUOTATION (RFQ) - Dual Signatures        -->
        <!-- ======================================================= -->
        <template id="bml_rfq_signature_block"
                  inherit_id="purchase.report_purchasequotation_document"
                  name="BML - RFQ Signature Block (Requester + Approver)"
                  priority="50">
            
            <!-- Insert at the end of the page content -->
            <xpath expr="//div[hasclass('page')]" position="inside">
                <div class="mt-5" style="page-break-inside: avoid;">
                    
                    <div class="row">
                        <!-- LEFT COLUMN: REQUESTER (Purchase Representative) -->
                        <div class="col-6">
                            <div class="text-center" style="width: 90%; margin: 0 auto;">
                                <!-- Space for Manual Signature (80px height) -->
                                <div style="height: 80px; display: flex; align-items: flex-end; justify-content: center;">
                                    <!-- Use o.user_id.signature if you have a digital field, otherwise blank for manual sign -->
                                    <span style="color: #eee;">.</span>
                                </div>
                                
                                <!-- Line -->
                                <div style="border-top: 1px solid black; width: 100%; margin: 5px auto;"/>
                                
                                <!-- Details -->
                                <span style="font-size: 11px;">ผู้ขอซื้อ / Requested by</span>
                                <br/>
                                <span t-field="o.user_id.name" style="font-weight: bold;"/>
                                <br/>
                                <span style="font-size: 11px;">วันที่ / Date: </span>
                                <span t-field="o.date_order" t-options='{"widget": "date"}'/>
                            </div>
                        </div>

                        <!-- RIGHT COLUMN: APPROVER (Manager) -->
                        <div class="col-6">
                            <div class="text-center" style="width: 90%; margin: 0 auto;">
                                <!-- Image Holder -->
                                <div style="height: 80px; display: flex; align-items: flex-end; justify-content: center;">
                                    <t t-if="o.x_studio_approval_signature">
                                        <img t-att-src="image_data_uri(o.x_studio_approval_signature)" 
                                             style="max-height: 75px; width: auto; object-fit: contain; margin-bottom: 2px;"/>
                                    </t>
                                    <t t-else="">
                                        <span style="color: #eee;">.</span>
                                    </t>
                                </div>

                                <!-- Line -->
                                <div style="border-top: 1px solid black; width: 100%; margin: 5px auto;"/>

                                <!-- Details -->
                                <span style="font-size: 11px;">ผู้อนุมัติ / Approved by</span>
                                <br/>
                                <!-- If approved, show date, else show placeholder line or empty -->
                                <t t-if="o.date_approve">
                                    <span style="font-size: 11px;">วันที่ / Date: </span>
                                    <span t-field="o.date_approve" t-options='{"widget": "date"}'/>
                                </t>
                                <t t-else="">
                                    <br/>
                                    <span style="font-size: 11px;">วันที่ / Date: _________________</span>
                                </t>
                            </div>
                        </div>
                    </div>

                </div>
            </xpath>
        </template>


        <!-- ======================================================= -->
        <!-- 3. ADDRESS FIX (Removing Top Padding)                   -->
        <!-- ======================================================= -->
        <template id="bml_address_padding_fix"
                  inherit_id="web.address_layout"
                  name="BML - Remove address top padding"
                  priority="100">
            <xpath expr="//div[@t-if=&quot;address&quot;]" position="attributes">
                <attribute name="style">padding-top: 0 !important; margin-top: 0 !important;</attribute>
                <attribute name="class">address row mb-0</attribute>
            </xpath>
        </template>


        <!-- ======================================================= -->
        <!-- 4. FOOTER (Purchase Order Specific)                     -->
        <!-- ======================================================= -->
        <template id="external_layout_boxed_footer"
                  inherit_id="web.external_layout_boxed"
                  name="Custom ISO Footer - Purchase Order Only">
            <xpath expr="//div[contains(@class, 'footer')]/div[not(@t-if) and not(@t-else)]" position="inside">
                <t t-set="model_name" t-value="o._name if o else False"/>
                <t t-if="model_name == 'purchase.order'">
                    <div class="w-100"></div>
                    <div class="row">
                        <div class="col-12 text-end">
                            <small class="text-muted font-weight-medium">
                                F-10-05 ฉบับ 04 วันที่บังคับใช้ 19 พ.ย.68
                            </small>
                        </div>
                    </div>
                </t>
            </xpath>
        </template>

    </data>
</odoo>