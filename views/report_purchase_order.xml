<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- BML - Signature left, Totals right - FINAL WORKING VERSION -->
        <template id="bml_po_signature_side_by_side"
                  inherit_id="purchase.report_purchaseorder_document"
                  name="BML - PO Signature left + Totals right"
                  priority="50">

            <!-- Optional: remove payment terms line -->
            <xpath expr="//p[@t-field='o.note']/following::strong[1]" position="replace"/>

            <!-- 1. Make the container clear floats (critical for wkhtmltopdf) -->
            <xpath expr="//div[@id='total']" position="attributes">
                <attribute name="class">mt-4</attribute>
                <attribute name="style">overflow: hidden; zoom: 1; min-height: 140px;</attribute>
            </xpath>

            <!-- 2. Insert signature on the LEFT using float left -->
            <xpath expr="//div[@id='total']/div[1]" position="before">
                <div style="float: left; width: 48%; text-align: center; min-height: 130px; padding-right: 20px; box-sizing: border-box;">
                    <div style="display: flex; flex-direction: column; justify-content: end; min-height: 75px;">
                        <t t-if="o.x_studio_approval_signature">
                            <img t-att-src="image_data_uri(o.x_studio_approval_signature)" style="max-height: 70px; width: auto; object-fit: contain;"/>
                        </t>
                        <t t-else="">
                            <div style="height: 70px;"/>
                        </t>
                    </div>
                    <div style="border-top: 2px solid black; width: 260px; margin: 8px auto 4px;"/>
                    <div style="font-size: 12px; line-height: 1.4;">
                        ผู้อนุมัติ / Approved by
                        <t t-if="o.date_approve">
                            <br/>
                            <span t-field="o.date_approve" t-options="{&quot;widget&quot;: &quot;date&quot;}"/>
                            <br/>วันที่อนุมัติ / Approval Date
                        </t>
                    </div>
                </div>
            </xpath>

            <!-- 3. Force original totals to the RIGHT using float right -->
            <xpath expr="//div[@id='total']/div[1]" position="attributes">
                <attribute name="style">float: right; width: 50%; min-width: 300px; margin: 0 !important;</attribute>
            </xpath>

        </template>

        <!-- Address padding fix - unchanged and safe -->
        <template id="bml_address_padding_fix"
                  inherit_id="web.address_layout"
                  name="BML - Remove address top padding"
                  priority="100">
            <xpath expr="//div[@t-if=&quot;address&quot;]" position="attributes">
                <attribute name="style">padding-top: 0 !important; margin-top: 0 !important;</attribute>
                <attribute name="class">address row mb-0</attribute>
            </xpath>
        </template>

        <template id="external_layout_boxed_footer"
                  inherit_id="web.external_layout_boxed"
                  name="Custom ISO Footer - Purchase Order Only">

            <!-- CORRECT: Use single quotes inside double quotes (standard Odoo way) -->
            <xpath expr="//div[contains(@class, 'footer')]/div[not(@t-if) and not(@t-else)]" position="inside">
                <t t-set="model_name" t-value="o._name if o else False"/>

                <t t-if="model_name == 'purchase.order'">
                    <div class="w-100"></div>
                    <div class="row">
                        <div class="col-12 text-end">
                            <small class="text-muted font-weight-medium">
                                F-10-05 ฉบับ 04 วันที่บังคับใช้ 19 พ.ย.68
                            </small>
                        </div>
                    </div>
                </t>
            </xpath>
        </template>

    </data>
</odoo>