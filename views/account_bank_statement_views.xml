<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Add Upload Thai Statement button to Bank Statement List View -->
        <record id="view_bank_statement_tree_thai_upload" model="ir.ui.view">
            <field name="name">account.bank.statement.list.thai.upload</field>
            <field name="model">account.bank.statement</field>
            <field name="inherit_id" ref="account.view_bank_statement_tree"/>
            <field name="arch" type="xml">
                <!-- Add button to the list view -->
                <xpath expr="//list" position="inside">
                    <header>
                        <button name="%(action_thai_bank_statement_upload_wizard)d" 
                                type="action" 
                                string="Upload Thai Statement"
                                class="btn-primary"
                                context="{'default_journal_id': context.get('default_journal_id')}"/>
                    </header>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
