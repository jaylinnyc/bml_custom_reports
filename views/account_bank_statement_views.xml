<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Override the bank statement list view to use our custom JS controller -->
        <record id="view_bank_statement_tree_thai_upload" model="ir.ui.view">
            <field name="name">account.bank.statement.list.thai.upload</field>
            <field name="model">account.bank.statement</field>
            <field name="inherit_id" ref="account.view_bank_statement_tree"/>
            <field name="arch" type="xml">
                <list position="attributes">
                    <attribute name="js_class">bank_statement_list_upload</attribute>
                </list>
            </field>
        </record>
    </data>
</odoo>
