<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- ======================================================= -->
        <!-- CUSTOM HEADER OVERRIDE                                  -->
        <!-- ======================================================= -->
        
        <template id="external_layout_custom_header"
                  inherit_id="web.external_layout_boxed"
                  name="Custom Image Header Override"
                  priority="16">
            
            <xpath expr="//div[contains(@class, 'header')]" position="replace">
                <div class="header">
                    <t t-set="company" t-value="o.company_id if hasattr(o, 'company_id') else res_company"/>
                    
                    <t t-if="company and hasattr(company, 'use_custom_report_header') and company.use_custom_report_header and company.report_header_image">
                        <!-- Custom Image Header -->
                        <div style="width: 100%; text-align: center; margin: 0; padding: 0;">
                            <img t-att-src="image_data_uri(company.report_header_image)"
                                 style="width: 100%; height: auto; max-height: 120px; object-fit: contain; display: block; margin: 0 auto;"
                                 alt="Company Header"/>
                        </div>
                    </t>
                    <t t-else="">
                        <!-- Standard Odoo Header (Fallback) -->
                        <div class="row">
                            <div class="col-3 mb4">
                                <img t-if="company.logo" t-att-src="image_data_uri(company.logo)" 
                                     style="max-height: 45px;" alt="Logo"/>
                            </div>
                            <div class="col-9 text-end" style="margin-top:22px;" t-field="company.report_header" name="moto"/>
                        </div>
                        <div t-if="company.logo or company.report_header" class="row zero_min_height">
                            <div class="col-12">
                                <div style="border-bottom: 1px solid black;"/>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-6" name="company_address">
                                <span t-field="company.partner_id"
                                      t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": true}'/>
                            </div>
                        </div>
                    </t>
                </div>
            </xpath>
        </template>

    </data>
</odoo>
