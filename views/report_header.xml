<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- ======================================================= -->
        <!-- CUSTOM HEADER OVERRIDE                                  -->
        <!-- ======================================================= -->
        
        <template id="external_layout_custom_header"
                  inherit_id="web.external_layout_boxed"
                  name="Custom Image Header Override"
                  priority="16">
            
            <!-- Replace the header section with custom image if enabled -->
            <xpath expr="//div[contains(@t-attf-class, 'header')]" position="replace">
                <div t-attf-class="header o_company_#{company.id}_layout">
                    <t t-if="company.use_custom_report_header and company.report_header_image">
                        <!-- Custom Image Header -->
                        <div style="width: 100%; text-align: center; margin: 0; padding: 0;">
                            <img t-att-src="image_data_uri(company.report_header_image)"
                                 style="width: 100%; height: auto; max-height: 120px; object-fit: contain; display: block; margin: 0 auto;"
                                 alt="Company Header"/>
                        </div>
                    </t>
                    <t t-else="">
                        <!-- Standard Odoo Header (Fallback) -->
                        <div class="row mb8">
                            <div class="col-4">
                                <img t-if="company.logo" class="o_company_logo_big" t-att-src="image_data_uri(company.logo)" alt="Logo"/>
                            </div>
                            <div class="col-8 text-end mb4">
                                <div name="company_address" class="mb4">
                                    <ul class="list-unstyled" name="company_address_list">
                                        <li t-if="company.is_company_details_empty"><span t-field="company.partner_id" t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": true}'/></li>
                                        <li t-else="">
                                            <span t-field="company.company_details"/>
                                        </li>
                                        <li t-if="not forced_vat"/>
                                        <li t-else="">
                                            <t t-esc="company.country_id.vat_label or 'Tax ID'"/>:
                                            <span t-esc="forced_vat"/>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>
            </xpath>
        </template>

    </data>
</odoo>
