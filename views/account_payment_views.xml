<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
    Account Payment View Extension
    
    Features:
    1. Invoice selector - select unpaid invoices for customer payments (draft)
    2. Link invoices - link invoices to existing confirmed payments (advance payments)
    3. Charge deduction - deduct bank charges/fees from payments
    -->

    <record id="view_account_payment_form_invoice_selector" model="ir.ui.view">
        <field name="name">account.payment.form.invoice.selector</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            
            <!-- Add technical fields -->
            <xpath expr="//field[@name='partner_type']" position="after">
                <field name="show_invoice_selector" invisible="1"/>
                <field name="can_link_invoices" invisible="1"/>
            </xpath>
            
            <!-- Add charge deduction section in group2 -->
            <xpath expr="//group[@name='group2']" position="inside">
                <separator string="Charge Deduction" colspan="2"/>
                <field name="apply_charge_deduction" 
                       string="Deduct Charges"
                       widget="boolean_toggle"
                       readonly="state != 'draft'"/>
                <field name="charge_amount" 
                       string="Charge Amount"
                       invisible="not apply_charge_deduction"
                       readonly="state != 'draft'"/>
                <field name="charge_account_id" 
                       string="Charge Account"
                       required="apply_charge_deduction and charge_amount > 0"
                       invisible="not apply_charge_deduction"
                       readonly="state != 'draft'"
                       options="{'no_create': True}"/>
                <field name="charge_label"
                       string="Description"
                       invisible="not apply_charge_deduction"
                       readonly="state != 'draft'"/>
                <field name="net_amount"
                       string="Net Amount"
                       invisible="not apply_charge_deduction or charge_amount == 0"
                       readonly="1"/>
            </xpath>
            
            <!-- Invoice selector for DRAFT payments -->
            <xpath expr="//group[@name='main_group']" position="after">
                <group string="Link to Invoices" 
                       name="invoice_selector_group"
                       invisible="not show_invoice_selector or state != 'draft'"
                       col="4">
                    
                    <group colspan="4">
                        <field name="selected_invoice_ids" 
                               widget="many2many_tags"
                               placeholder="Select unpaid invoices..."
                               options="{'no_create': True, 'color_field': 'payment_state'}"
                               domain="[('move_type', 'in', ['out_invoice', 'out_refund']), 
                                       ('state', '=', 'posted'), 
                                       ('payment_state', 'in', ['not_paid', 'partial']), 
                                       ('partner_id', '=', partner_id)]"
                               context="{'default_partner_id': partner_id}"/>
                    </group>
                    
                    <group colspan="2">
                        <field name="selected_invoices_amount" 
                               string="Total Due"
                               readonly="1"
                               invisible="not selected_invoice_ids"/>
                    </group>
                    
                    <!-- Detailed invoice list view sorted by due date -->
                    <group colspan="4" invisible="not selected_invoice_ids">
                        <field name="selected_invoice_ids" nolabel="1" colspan="4">
                            <list create="false" delete="true" editable="bottom" default_order="invoice_date_due asc">
                                <field name="name" string="Invoice" readonly="1"/>
                                <field name="invoice_date" string="Invoice Date" readonly="1"/>
                                <field name="invoice_date_due" string="Due Date" readonly="1" 
                                       decoration-danger="invoice_date_due and invoice_date_due &lt; current_date"/>
                                <field name="amount_total" string="Total" readonly="1" sum="Total"/>
                                <field name="amount_residual" string="Amount Due" readonly="1" sum="Total Due"/>
                                <field name="payment_state" string="Status" 
                                       widget="badge"
                                       decoration-warning="payment_state == 'partial'"
                                       decoration-danger="payment_state == 'not_paid'"
                                       readonly="1"/>
                                <field name="currency_id" column_invisible="True"/>
                            </list>
                        </field>
                    </group>
                </group>
                
                <!-- Link Invoices section for CONFIRMED payments (advance payments) -->
                <group string="Link Invoices to Payment" 
                       name="link_invoices_group"
                       invisible="not can_link_invoices"
                       col="4">
                    
                    <div colspan="4" class="alert alert-info mb-3" role="status">
                        <strong>Advance Payment:</strong> This payment has 
                        <field name="unreconciled_amount" class="oe_inline" readonly="1"/> 
                        unreconciled. Select invoices below to link and reconcile.
                    </div>
                    
                    <group colspan="4">
                        <field name="selected_invoice_ids" 
                               widget="many2many_tags"
                               placeholder="Select invoices to link..."
                               options="{'no_create': True, 'color_field': 'payment_state'}"
                               domain="[('move_type', 'in', ['out_invoice', 'out_refund']), 
                                       ('state', '=', 'posted'), 
                                       ('payment_state', 'in', ['not_paid', 'partial']), 
                                       ('partner_id', '=', partner_id)]"
                               context="{'default_partner_id': partner_id}"/>
                    </group>
                    
                    <group colspan="2">
                        <field name="selected_invoices_amount" 
                               string="Selected Invoices Total"
                               readonly="1"
                               invisible="not selected_invoice_ids"/>
                    </group>
                    
                    <!-- Detailed invoice list view sorted by due date -->
                    <group colspan="4" invisible="not selected_invoice_ids">
                        <field name="selected_invoice_ids" nolabel="1" colspan="4">
                            <list create="false" delete="true" editable="bottom" default_order="invoice_date_due asc">
                                <field name="name" string="Invoice" readonly="1"/>
                                <field name="invoice_date" string="Invoice Date" readonly="1"/>
                                <field name="invoice_date_due" string="Due Date" readonly="1"
                                       decoration-danger="invoice_date_due and invoice_date_due &lt; current_date"/>
                                <field name="amount_total" string="Total" readonly="1" sum="Total"/>
                                <field name="amount_residual" string="Amount Due" readonly="1" sum="Total Due"/>
                                <field name="payment_state" string="Status" 
                                       widget="badge"
                                       decoration-warning="payment_state == 'partial'"
                                       decoration-danger="payment_state == 'not_paid'"
                                       readonly="1"/>
                                <field name="currency_id" column_invisible="True"/>
                            </list>
                        </field>
                    </group>
                    
                    <!-- Link button -->
                    <group colspan="4">
                        <button name="action_link_invoices" 
                                string="Link &amp; Reconcile Selected Invoices"
                                type="object"
                                class="btn-primary"
                                invisible="not selected_invoice_ids"
                                confirm="This will reconcile the selected invoices with this payment. Continue?"/>
                    </group>
                </group>
            </xpath>
            
        </field>
    </record>

</odoo>
